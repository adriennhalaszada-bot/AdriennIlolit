{
  "$schema": "node_modules/wrangler/config-schema.json",
  // ILOLIT Cloudflare Pages fő projekt konfiguráció.
  // Társ Cloudflare Cron Worker (* * * * *): workers/ilolit-cron/wrangler.jsonc
  "name": "ilolit",
  "pages_build_output_dir": "./dist/public",
  "compatibility_date": "2026-08-22",
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "loloit-images"
    }
  ],
  "observability": {
    "enabled": true
  }
}
