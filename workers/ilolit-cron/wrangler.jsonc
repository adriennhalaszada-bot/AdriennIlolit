{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ilolit-cron-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "triggers": {
    "crons": ["* * * * *"]
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "loloit-images"
    }
  ],
  "observability": {
    "enabled": true
  }
}
